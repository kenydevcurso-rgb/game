rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function matchDoc(matchId) { return get(/databases/$(database)/documents/matches/$(matchId)); }
    function isOrganizer(matchId) {
      return signedIn() && exists(/databases/$(database)/documents/matches/$(matchId)/organizers/$(request.auth.uid));
    }
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOrganizer(matchId);
      match /organizers/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOrganizer(matchId));
        allow create: if signedIn() && request.auth.uid == uid && matchDoc(matchId).data.ownerUid == uid;
        allow update, delete: if false;
      }
      match /teams/{teamId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == teamId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.completedMissions == 0;
        allow update: if isOrganizer(matchId) || (signedIn() && request.auth.uid == teamId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','lastSeen','members','name']));
        allow delete: if isOrganizer(matchId);
      }
      match /submissions/{submissionId} {
        allow read: if signedIn() && (isOrganizer(matchId) || resource.data.teamId == request.auth.uid);
        allow create: if signedIn() && request.resource.data.teamId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['teamId','teamName','missionNumber','language','code','explanation','status','createdAt']);
        allow update, delete: if false;
      }
      match /evaluations/{evaluationId} {
        allow read: if signedIn() && isOrganizer(matchId);
        allow write: if false; // Somente Cloud Functions com Admin SDK.
      }
      match /audit/{eventId} {
        allow read: if signedIn() && isOrganizer(matchId);
        allow write: if false; // Somente Cloud Functions com Admin SDK.
      }
    }
  }
}
